<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 暂不把 IDE 风格规则拉进构建：老代码一次会爆 1.5 万条风格告警，淹没真问题。
         需要时用 dotnet format 单独处理格式，不让它污染编译期。 -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- 噪音规则（非缺陷）：
         CA1707 测试方法用下划线命名（本项目约定）
         CA1848/CA1873 日志改用 LoggerMessage 的性能建议
         CA1309/CA1310 字符串比较风格
         CA1859/CA1822 性能微调
         保留 CA1305（区域性）、CA1001（可释放）、CA2012（ValueTask）、CA2016（令牌传递）等真问题 -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA1309;CA1310;CA1859;CA1822</NoWarn>
  </PropertyGroup>
</Project>

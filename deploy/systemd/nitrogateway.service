[Unit]
Description=NitroGateway edge gateway stack (docker compose)
Documentation=https://github.com/jiujiugou/NitroGateway
Requires=docker.service network-online.target
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nitrogateway
# 容器级崩溃自愈由 docker-compose.yml 的 restart: unless-stopped 负责；
# 本 unit 只负责"开机拉起整套栈 / 关机优雅停栈"。
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target

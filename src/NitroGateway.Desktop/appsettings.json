{
  // ADR-026：桌面端配置。Persistence:ConnectionString 缺省时由 DesktopPathConfig 落到 %LocalAppData%\NitroGateway；
  // Serilog 文件路径缺省时同样落到 %LocalAppData%\NitroGateway\logs（可用环境变量覆盖）。
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/nitrogateway-desktop-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Persistence": {
    "MeasurementRetentionDays": 30,
    "MeasurementRetentionInterval": "1.00:00:00",
    "ForwardBufferMaxPending": 100000,
    "DeadLetterRetentionDays": 30
  },
  "Disk": {
    "IntervalSeconds": 60,
    "WarningFreeBytes": 1073741824,
    "CriticalFreeBytes": 268435456,
    "RecoveryMarginPercent": 20
  },
  "MQTT": {
    "Host": "localhost",
    "Port": 1883,
    "KeepAliveSeconds": 60,
    "MaxReconnectAttempts": 10,
    "ReconnectBackoffBaseMs": 1000,
    "ReconnectMaxIntervalMs": 30000,
    "UseTls": false
  },
  "Collection": {
    "IntervalMs": 1000,
    "MaxConcurrency": 5,
    "CircuitBreakerOpenSeconds": 5,
    "CircuitBreakerMaxOpenSeconds": 300
  },
  "Forwarder": {
    "IntervalMs": 5000,
    "Channels": "mqtt",
    "Http": {
      "BaseUrl": "",
      "Path": "/api/measurements/batch",
      "AuthType": "None",
      "TimeoutMs": 30000,
      "MaxRetries": 3,
      "HealthPath": "/health"
    }
  }
}

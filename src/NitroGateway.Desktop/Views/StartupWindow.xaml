<Window x:Class="NitroGateway.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroGateway 现场采集端" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource PageBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13.5">
    <!-- ADR-037 S8：启动反馈窗口——宿主启动（迁移+后台服务）期间可见，失败时窗口内提示而非仅 MessageBox -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderLight}"
            BorderThickness="1" Padding="28">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="10">
                    <!-- ADR-037 S10：品牌块渐变 -->
                    <Border.Background>
                        <StaticResource ResourceKey="BrandGradientBrush" />
                    </Border.Background>
                    <TextBlock Text="NG" Foreground="White" FontWeight="Bold" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NitroGateway" FontWeight="Bold" FontSize="17" />
                    <TextBlock Text="现场采集端" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="正在启动采集服务…" Foreground="{StaticResource TextRegular}"
                       Margin="0,22,0,0" />
            <!-- 进度条：启动中可见；失败（IsFailed=true）隐藏 -->
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,12">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <!-- 状态文案：默认次级色；失败（IsFailed=true）置红 -->
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="关闭" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" Click="OnClose"
                    HorizontalAlignment="Right" Margin="0,20,0,0" Padding="22,6" />
        </StackPanel>
    </Border>
</Window>

<Window x:Class="NitroGateway.Desktop.Views.PointBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:dev="clr-namespace:NitroGateway.Domain.Devices;assembly=NitroGateway.Domain"
        Width="560" Height="460" MinWidth="480" MinHeight="380" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13.5">
    <Window.Resources>
        <!-- 合并共享样式：无 Application 实例（单元测试冒烟）时也能解析 StaticResource（PrimaryButtonStyle 等） -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="DataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dev:DataType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="PointAccessValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dev:PointAccess" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="批量生成点位" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="按名称模板与起始地址批量创建点位" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- docs/13：批量生成表单，字段与 Web PointList.vue 批量生成对话框对齐 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 行 1：名称模板 / 起始地址 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                        <TextBlock Text="名称模板" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding NameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="如 AI_{000} → AI_001, AI_002...（000 为零填充序号占位符）" />
                        <TextBlock Text="{Binding PreviewName}" Style="{StaticResource FormHintStyle}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="起始地址" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding AddressHint}" />
                    </StackPanel>

                    <!-- 行 2：数量 / 数据类型 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                        <TextBlock Text="数量（1-5000）" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="数据类型" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource DataTypeValues}}"
                                  SelectedItem="{Binding DataType}" />
                    </StackPanel>

                    <!-- 行 3：权限 / 提示占位 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                        <TextBlock Text="权限" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource PointAccessValues}}"
                                  SelectedItem="{Binding Access}" />
                    </StackPanel>

                    <!-- 行 4：递增规则提示 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding GenHint}" Style="{StaticResource FormHintStyle}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="96" Margin="0,0,12,0" IsCancel="True" Click="OnCancel" />
            <Button Content="生成" Width="96" IsDefault="True" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>

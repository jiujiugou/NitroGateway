<Window x:Class="NitroGateway.Desktop.Views.OpcUaPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="560" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13.5">
    <!-- 合并共享样式：无 Application 实例（单元测试冒烟）时也能解析 StaticResource -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="从服务器地址空间选点，管理该设备的 OPC UA 点位" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具栏（卡片）：OPC UA 无批量生成，地址来自地址空间点选 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <Button Content="⬆ 导入 CSV" Command="{Binding ImportCsvCommand}" Margin="0,0,8,0" />
                        <Button Content="⬇ 导出 CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                        <Button Content="+ 从服务器选点" Command="{Binding AddCommand}"
                                Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="编辑" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerTextButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedPoint}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="NodeId（地址）" Binding="{Binding Address}" Width="200" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="类型" Binding="{Binding DataTypeText}" Width="80" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="权限" Binding="{Binding AccessText}" Width="70" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="缩放 × / +" Binding="{Binding ScaleText}" Width="110" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="采集间隔" Binding="{Binding ScanIntervalText}" Width="80" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="启用" Binding="{Binding EnabledText}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="暂无点位。点击「从服务器选点」浏览地址空间并选取变量节点。" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>

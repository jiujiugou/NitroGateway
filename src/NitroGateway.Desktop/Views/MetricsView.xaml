<UserControl x:Class="NitroGateway.Desktop.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel Grid.Row="0" Margin="26,22,26,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastUpdatedText, StringFormat=更新于 {0}}" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,3" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="系统监控" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="本进程运行指标（采集 / 转发链路），自动刷新；历史与告警见 Prometheus"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 分组卡片 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,26,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Width="430" Padding="18,14" Margin="0,0,14,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="14" CornerRadius="1.5"
                                            Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextRegular}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="12" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 页脚状态行 -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                   Margin="26,0,26,10" HorizontalAlignment="Left"
                   Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
    </Grid>
</UserControl>

<Window x:Class="NitroGateway.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NitroGateway.Desktop.ViewModels"
        xmlns:views="clr-namespace:NitroGateway.Desktop.Views"
        Title="NitroGateway 现场采集端" Height="760" Width="1240"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13.5">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RealtimeViewModel}"><views:RealtimeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmsViewModel}"><views:AlarmsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmRulesViewModel}"><views:AlarmRulesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

        <!-- 侧栏导航（深色两级树）：一级「协议」目录点击仅展开/收起且不高亮；
             二级/顶级页面项悬停浅灰底、选中主色圆角胶囊 + 白色文字 -->
        <Style x:Key="NavNodeStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource NavForeground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <!-- 单向：选中态以 ViewModel 为唯一真源，避免 TreeView 容器初始化/切换把 VM 状态回写冲掉 -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <EventSetter Event="Selected" Handler="OnNavNodeSelected" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="13,11">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- 目录收起时隐藏子项（自定制模板必须自带，默认模板靠的就是这条） -->
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <!-- 高亮跟随 VM 的 IsSelected（不依赖 TreeViewItem.IsSelected，避免选中态丢失） -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：深色渐变 + 品牌区 + 菜单 + 页脚 -->
            <Border Grid.Column="0" Background="{StaticResource NavGradientBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="9">
                                <Border.Background>
                                    <StaticResource ResourceKey="BrandGradientBrush" />
                                </Border.Background>
                                <TextBlock Text="NG" Foreground="White" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NitroGateway" Foreground="White" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="现场采集端" Foreground="{StaticResource NavMutedBrush}" FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="20,14,20,18">
                        <Border Height="1" Background="{StaticResource NavHoverBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="本地采集 · 单机运行" Foreground="{StaticResource NavMutedBrush}" FontSize="11.5" />
                    </StackPanel>

                    <!-- 两级导航树：一级目录（协议）+ 二级页面项；选中态由 NavNode.IsSelected 双向绑定驱动 -->
                    <TreeView ItemsSource="{Binding NavTree}"
                              Background="Transparent" BorderThickness="0" Padding="10,0"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource NavNodeStyle}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource NavMutedBrush}"
                                               Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 显式绑定容器前景色：与悬停/选中（白色）联动，不依赖属性继承 -->
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                                    </StackPanel>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- 状态栏（ADR-026 D9：MQTT 状态 + 缓冲水位现场可视） -->
        <Border Grid.Row="1" Background="{StaticResource StatusBarBackground}"
                BorderBrush="{StaticResource StatusBarTopBorderBrush}" BorderThickness="0,1,0,0"
                Padding="22,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MQTT" Foreground="{StaticResource StatusBarText}" FontSize="12" />
                <TextBlock Text="{Binding MqttStateText}" Foreground="White" FontWeight="SemiBold"
                           FontSize="12" Margin="6,0,0,0" />
                <Border Width="1" Height="14" Background="{StaticResource StatusBarSeparatorBrush}" Margin="20,0" />
                <TextBlock Text="缓冲积压" Foreground="{StaticResource StatusBarText}" FontSize="12" />
                <TextBlock Text="{Binding BufferBacklogText}" Foreground="White" FontWeight="SemiBold"
                           FontSize="12" Margin="6,0,0,0" />
                <Border Width="1" Height="14" Background="{StaticResource StatusBarSeparatorBrush}" Margin="20,0" />
                <TextBlock Text="设备" Foreground="{StaticResource StatusBarText}" FontSize="12" />
                <TextBlock Text="{Binding DeviceCountText}" Foreground="White" FontWeight="SemiBold"
                           FontSize="12" Margin="6,0,0,0" />
                <Border Width="1" Height="14" Background="{StaticResource StatusBarSeparatorBrush}" Margin="20,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource StatusBarText}" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="NitroGateway.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NitroGateway.Desktop.ViewModels"
        xmlns:views="clr-namespace:NitroGateway.Desktop.Views"
        Title="NitroGateway 现场采集端" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RealtimeViewModel}"><views:RealtimeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmsViewModel}"><views:AlarmsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

        <!-- 左侧导航项：悬停浅灰、选中主色底 + 左侧主色条 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                Padding="16,11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：品牌区 + 菜单 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,20,18">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="NG" Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NitroGateway" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="现场采集端" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- 状态栏（ADR-026 D9：MQTT 状态 + 缓冲水位现场可视） -->
        <Border Grid.Row="1" Background="#2B3A4A" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MQTT：" Foreground="#9FB3C8" />
                <TextBlock Text="{Binding MqttStateText}" Foreground="White" FontWeight="SemiBold" Margin="2,0,18,0" />
                <TextBlock Text="缓冲积压：" Foreground="#9FB3C8" />
                <TextBlock Text="{Binding BufferBacklogText}" Foreground="White" FontWeight="SemiBold" Margin="2,0,18,0" />
                <TextBlock Text="设备：" Foreground="#9FB3C8" />
                <TextBlock Text="{Binding DeviceCountText}" Foreground="White" FontWeight="SemiBold" Margin="2,0,18,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="#9FB3C8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

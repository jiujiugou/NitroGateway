<UserControl x:Class="NitroGateway.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 合并共享样式（Themes/Styles.xaml）：无 Application 实例（单元测试冒烟）时也能解析 StaticResource -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="设备：" VerticalAlignment="Center" />
            <ComboBox Width="170" ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDevice}" Margin="4,0,12,0" />
            <TextBlock Text="点位：" VerticalAlignment="Center" />
            <ComboBox Width="170" ItemsSource="{Binding Points}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedPoint}" Margin="4,0,12,0" />
            <TextBlock Text="从：" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="4,0,12,0" />
            <TextBlock Text="到：" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="4,0,12,0" />
            <Button Content="近 1 天" Command="{Binding QuickRangeCommand}" CommandParameter="1" Padding="8,4" Margin="0,0,6,0" />
            <Button Content="近 3 天" Command="{Binding QuickRangeCommand}" CommandParameter="3" Padding="8,4" Margin="0,0,6,0" />
            <Button Content="近 7 天" Command="{Binding QuickRangeCommand}" CommandParameter="7" Padding="8,4" Margin="0,0,12,0" />
            <Button Content="查询" Command="{Binding QueryCommand}" Padding="14,4" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="上一页" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" Padding="8,4" Margin="8,0,6,0" />
            <TextBlock Text="{Binding PageNumber, StringFormat=第 {0} 页}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Padding="8,4" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusText}" Margin="0,0,0,6" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      AlternatingRowBackground="#F5F7FA" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimestampText}" Width="170" />
                    <DataGridTextColumn Header="工程值" Binding="{Binding ValueText}" Width="*" />
                    <DataGridTextColumn Header="原始值" Binding="{Binding RawValueText}" Width="*" />
                    <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="90" />
                    <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="NitroGateway.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 合并共享样式（Themes/Styles.xaml）：无 Application 实例（单元测试冒烟）时也能解析 StaticResource -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="26,22,26,14">
            <TextBlock Text="历史查询" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="按设备与时间范围检索历史采集数据" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="26,0,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 查询工具栏（卡片） -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="设备" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,0,0" />
                    <ComboBox Width="150" ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedDevice}" Margin="6,0,12,0" />
                    <TextBlock Text="点位" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" />
                    <ComboBox Width="150" ItemsSource="{Binding Points}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedPoint}" Margin="6,0,12,0" />
                    <TextBlock Text="从" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="124" Margin="6,0,12,0" />
                    <TextBlock Text="到" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="124" Margin="6,0,14,0" />
                    <!-- ADR-037 S3：查询中禁用查询/快捷区间按钮并显示进度条 -->
                    <Button Content="近 1 天" Command="{Binding QuickRangeCommand}" CommandParameter="1"
                            IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="近 3 天" Command="{Binding QuickRangeCommand}" CommandParameter="3"
                            IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="近 7 天" Command="{Binding QuickRangeCommand}" CommandParameter="7"
                            IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="0,0,12,0" />
                    <Button Content="查询" Command="{Binding QueryCommand}" IsEnabled="{Binding IsIdle}"
                            Padding="18,6" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="上一页" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"
                            Padding="10,6" Margin="12,0,6,0" />
                    <TextBlock Text="{Binding PageNumber, StringFormat=第 {0} 页}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                            Padding="10,6" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- ADR-037 S3：查询中在状态行显示进度条（工具栏已满，避免窗口宽度溢出） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ProgressBar Width="120" Height="6" IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="时间" Binding="{Binding TimestampText}" Width="170" />
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="工程值" Binding="{Binding ValueText}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="原始值" Binding="{Binding RawValueText}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="质量" Binding="{Binding Quality}" Width="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="错误" Binding="{Binding Error}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- ADR-037 S3：空态提示，有数据时折叠 -->
                    <TextBlock Text="暂无数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

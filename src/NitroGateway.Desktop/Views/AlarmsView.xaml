<UserControl x:Class="NitroGateway.Desktop.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,4" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  AlternatingRowBackground="#F5F7FA" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                            <Setter Property="Background" Value="#F8D7DA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                            <Setter Property="Background" Value="#FDE2E4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter Property="Background" Value="#FFF3CD" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="发生时间" Binding="{Binding OccurredText}" Width="160" />
                <DataGridTextColumn Header="严重性" Binding="{Binding SeverityText}" Width="90" />
                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="80" />
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="*" />
                <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                <DataGridTextColumn Header="触发值" Binding="{Binding TriggerValue, StringFormat=F2}" Width="90" />
                <DataGridTextColumn Header="阈值" Binding="{Binding Threshold, StringFormat=F2}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

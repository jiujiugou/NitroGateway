<UserControl x:Class="NitroGateway.Desktop.Views.RealtimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="设备：" VerticalAlignment="Center" />
            <ComboBox Width="220" ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDevice}" Margin="4,0,16,0" />
            <TextBlock Text="点位：" VerticalAlignment="Center" />
            <ComboBox Width="220" ItemsSource="{Binding Points}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedPoint}" Margin="4,0,0,0" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectedItem="{Binding SelectedPoint}"
                      AlternatingRowBackground="#F5F7FA" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBad}" Value="True">
                                <Setter Property="Background" Value="#FDE7E9" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="100" />
                    <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="80" />
                    <DataGridTextColumn Header="值" Binding="{Binding ValueText}" Width="*" />
                    <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="70" />
                    <DataGridTextColumn Header="时间" Binding="{Binding TimestampText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" BorderBrush="#D9DEE4" BorderThickness="1" CornerRadius="4" Padding="8" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,6">
                        <Run Text="曲线：" />
                        <Run Text="{Binding SelectedPoint.Name, FallbackValue=请选择点位查看曲线}" />
                    </TextBlock>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="NitroGateway.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 合并共享样式（Themes/Styles.xaml）：无 Application 实例（单元测试冒烟）时也能解析 StaticResource -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="26,22,26,14">
            <TextBlock Text="设备管理" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="现场设备与采集点位配置" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="26,0,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ADR-038 统计卡片：设备总数 / 在线 / 离线 / 点位数 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource PrimaryLightBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource IconDevicesTotal}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="设备总数" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource StatusOnlineBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource IconOnline}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource StatusOnlineBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="在线" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding OnlineCount}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource StatusOnlineBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource StatusOfflineBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource IconOffline}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource StatusOfflineBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="离线" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding OfflineCount}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource StatusOfflineBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource StatusMaintenanceBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource IconPoints}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource StatusMaintenanceBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="点位数" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalPoints}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 工具栏（卡片）：状态文本 + 操作按钮 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- ADR-037 S3：加载中禁用刷新并显示进度条，避免无反馈的防重入吞点击 -->
                        <Button Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                                Margin="0,0,8,0" />
                        <Button Content="+ 新增设备" Command="{Binding AddDeviceCommand}"
                                Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="编辑" Command="{Binding EditDeviceCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding DeleteDeviceCommand}"
                                Margin="0,0,8,0" Style="{StaticResource DangerTextButtonStyle}" />
                        <Button Content="点位管理" Command="{Binding ManagePointsCommand}" Margin="0,0,8,0" />
                        <ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="4,0,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedDevice}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="48">
                    <DataGrid.Columns>
                        <!-- ADR-038：设备名列 = 图标 + 名称/协议双层，行内即展示协议信息 -->
                        <DataGridTemplateColumn Header="设备名称" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" CornerRadius="7"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{StaticResource IconDevice}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{Binding Protocol}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ADR-038：状态徽章（软底 + 圆点，对齐 Web DeviceStatusTag 语义色） -->
                        <DataGridTemplateColumn Header="状态" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Badge" CornerRadius="11" Padding="9,3"
                                            Background="{StaticResource StatusUnknownBg}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Width="6" Height="6"
                                                     Fill="{StaticResource StatusUnknownBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="Txt" Text="{Binding StatusText}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource StatusUnknownBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource StatusOnlineBg}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource StatusOnlineBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource StatusOnlineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource StatusOfflineBg}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource StatusOfflineBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource StatusOfflineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource StatusErrorBg}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource StatusErrorBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource StatusMaintenanceBg}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource StatusMaintenanceBrush}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource StatusMaintenanceBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="从站" Binding="{Binding UnitIdText}" Width="60" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="上次采集" Binding="{Binding LastCollectionText}" Width="96" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="点位数" Binding="{Binding PointsCount}" Width="56" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="错误" Binding="{Binding LastError}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <!-- ADR-037 S3：空态提示，有数据时折叠 -->
                <TextBlock Text="暂无数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="NitroGateway.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 合并共享样式（Themes/Styles.xaml）：无 Application 实例（单元测试冒烟）时也能解析 StaticResource -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="+ 新增设备" Command="{Binding AddDeviceCommand}" Padding="12,4" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="编辑" Command="{Binding EditDeviceCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="删除" Command="{Binding DeleteDeviceCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="点位管理" Command="{Binding ManagePointsCommand}" Padding="12,4" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True"
                  AlternatingRowBackground="#F5F7FA" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="130" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                <DataGridTextColumn Header="上次采集" Binding="{Binding LastCollectionText}" Width="100" />
                <DataGridTextColumn Header="点位" Binding="{Binding PointsCount}" Width="60" />
                <DataGridTextColumn Header="错误" Binding="{Binding LastError}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl x:Class="NitroGateway.Desktop.Views.AlarmRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 合并共享样式（Themes/Styles.xaml）：无 Application 实例（单元测试冒烟）时也能解析 StaticResource -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="26,22,26,14">
            <TextBlock Text="告警规则" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="按设备/点位配置条件，达到后触发报警" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="26,0,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具栏（卡片）：状态 + 新增/编辑/删除/刷新 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="新增" Command="{Binding AddRuleCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="编辑" Command="{Binding EditRuleCommand}" Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding DeleteRuleCommand}" Style="{StaticResource DangerButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}" />
                        <!-- ADR-037 S3：加载中显示进度条 -->
                        <ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="10,0,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectedItem="{Binding SelectedRule}">
                    <DataGrid.RowStyle>
                        <!-- 禁用规则整行置灰，便于现场区分启用/禁用（ADR-043） -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="设备" Binding="{Binding DeviceName}" Width="*" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="点位" Binding="{Binding PointName}" Width="*" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="条件" Binding="{Binding Condition}" Width="*" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="时长" Binding="{Binding DurationText}" Width="80" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="等级" Binding="{Binding SeverityText}" Width="100" />
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridCellTextStyle}" Header="状态" Binding="{Binding EnabledText}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <!-- ADR-037 S3：空态提示，有数据时折叠 -->
                <TextBlock Text="暂无规则，点击「新增」为设备/点位配置触发条件"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="NitroGateway.Desktop.Views.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:dev="clr-namespace:NitroGateway.Domain.Devices;assembly=NitroGateway.Domain"
        Width="720" Height="620" MinWidth="560" MinHeight="400" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- 合并共享样式：无 Application 实例（单元测试冒烟）时也能解析 StaticResource（PrimaryButtonStyle 等） -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ObjectDataProvider x:Key="DeviceStatusValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="dev:DeviceStatus" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ADR-037 S6：可缩放窗口 + 内容滚动，小屏/高 DPI 不截断 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 行 1：名称 / 协议 / 传输方式 / 状态 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
            <TextBlock Text="设备名称" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
            <TextBlock Text="协议" />
            <ComboBox SelectedItem="{Binding ProtocolName}">
                <sys:String>Modbus</sys:String>
                <sys:String>S7</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
            <TextBlock Text="传输方式" />
            <ComboBox SelectedItem="{Binding Dialect}">
                <sys:String>TCP</sys:String>
                <sys:String>RTU</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
            <TextBlock Text="状态" />
            <ComboBox ItemsSource="{Binding Source={StaticResource DeviceStatusValues}}"
                      SelectedItem="{Binding Status}" />
        </StackPanel>

        <!-- 行 2：连接地址 / UnitId / 字节序 / Rack -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
            <TextBlock Text="连接地址（串口填 COM3 等）" />
            <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12"
                    Visibility="{Binding IsModbus, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="从站地址 UnitId" />
            <TextBox Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,12"
                    Visibility="{Binding IsModbus, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="字节序" />
            <ComboBox SelectedItem="{Binding DataFormat}">
                <sys:String>ABCD</sys:String>
                <sys:String>CDAB</sys:String>
                <sys:String>BADC</sys:String>
                <sys:String>DCBA</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,12"
                    Visibility="{Binding IsS7, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Rack（机架）" />
            <TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 行 3：Slot / CpuType / PingAddress / 波特率 -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12"
                    Visibility="{Binding IsS7, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Slot（插槽）" />
            <TextBox Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,12"
                    Visibility="{Binding IsS7, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="CPU 型号" />
            <ComboBox SelectedItem="{Binding CpuType}">
                <sys:String>S-1200</sys:String>
                <sys:String>S-1500</sys:String>
                <sys:String>S-300</sys:String>
                <sys:String>S-400</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,12,12"
                    Visibility="{Binding IsS7, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Ping 地址（如 DB1.DBW0）" />
            <TextBox Text="{Binding PingAddress, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,12"
                    Visibility="{Binding IsRtu, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="波特率" />
            <ComboBox Text="{Binding BaudRate}" IsEditable="True">
                <sys:String>9600</sys:String>
                <sys:String>19200</sys:String>
                <sys:String>38400</sys:String>
                <sys:String>57600</sys:String>
                <sys:String>115200</sys:String>
            </ComboBox>
        </StackPanel>

        <!-- 行 4：校验位 / 超时 -->
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12"
                    Visibility="{Binding IsRtu, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="校验位" />
            <ComboBox SelectedItem="{Binding Parity}">
                <sys:String>None</sys:String>
                <sys:String>Even</sys:String>
                <sys:String>Odd</sys:String>
                <sys:String>Mark</sys:String>
                <sys:String>Space</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,12,12" Visibility="{Binding IsRtu, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="数据位" />
            <ComboBox Text="{Binding DataBits}" IsEditable="True">
                <sys:String>8</sys:String>
                <sys:String>7</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,12,12" Visibility="{Binding IsRtu, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="停止位" />
            <ComboBox SelectedItem="{Binding StopBits}">
                <sys:String>One</sys:String>
                <sys:String>Two</sys:String>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,12,12">
            <TextBlock Text="连接超时(ms)" />
            <TextBox Text="{Binding ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,12">
            <TextBlock Text="请求超时(ms)" />
            <TextBox Text="{Binding RequestTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
            <TextBlock Text="重试次数" />
            <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 行 5：重试间隔 / 描述 -->
        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,12,12">
            <TextBlock Text="重试间隔(ms)" />
            <TextBox Text="{Binding RetryIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,12">
            <TextBlock Text="描述" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 行 6：按钮 -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="90" Margin="0,0,12,0" IsDefault="True" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="取消" Width="90" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

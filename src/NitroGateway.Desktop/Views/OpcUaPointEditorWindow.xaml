<Window x:Class="NitroGateway.Desktop.Views.OpcUaPointEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:dev="clr-namespace:NitroGateway.Domain.Devices;assembly=NitroGateway.Domain"
        Width="1000" Height="640" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13.5">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="DataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dev:DataType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="PointAccessValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dev:PointAccess" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="左侧浏览服务器地址空间，点选变量节点回填地址/类型/权限" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- ADR-070 层次1：左=服务器地址空间（懒加载），右=点位映射与采集配置 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="服务器地址空间" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding LoadRootsCommand}" Padding="10,3" />
                    </DockPanel>

                    <TreeView Grid.Row="1" ItemsSource="{Binding Nodes}"
                              SelectedItemChanged="OnTreeSelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Grid.Row="2" Text="{Binding BrowseStatusText}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 服务器类型不在网关支持列表时的手动选择提示（对齐 web OpcUaPointTable 告警） -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,12"
                            Visibility="{Binding HasTypeWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TypeWarning}" TextWrapping="Wrap"
                                   Foreground="{StaticResource StatusErrorBrush}" FontSize="12.5" />
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 行 1：名称 / NodeId / 类型 / 权限 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="点位名称" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,14">
                                <TextBlock Text="NodeId（地址）" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.Address, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding Form.AddressHint}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,14">
                                <TextBlock Text="数据类型" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource DataTypeValues}}"
                                          SelectedItem="{Binding Form.DataType}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,14">
                                <TextBlock Text="权限" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource PointAccessValues}}"
                                          SelectedItem="{Binding Form.Access}" />
                            </StackPanel>

                            <!-- 行 2：缩放 / 死区 / 采集间隔 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                                <TextBlock Text="缩放系数" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.ScaleFactor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,14">
                                <TextBlock Text="缩放偏移" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.ScaleOffset, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,14">
                                <TextBlock Text="死区" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.Deadband, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,14">
                                <TextBlock Text="采集间隔(ms，0=继承)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.ScanIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- 行 3：启用 + 描述 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Form.Enabled}" VerticalAlignment="Center" />
                                <TextBlock Text="启用采集" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                <TextBlock Text="描述" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Text="{Binding Form.Description, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="96" Margin="0,0,12,0" IsCancel="True" Click="OnCancel" />
            <Button Content="保存" Width="96" IsDefault="True" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="NitroGateway.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ADR-037 S1：合并共享样式，令牌（MutedText 等）在无 Application 实例（单元测试冒烟）时也可解析 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NitroGateway.Desktop;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="680" HorizontalAlignment="Left">
            <GroupBox Header="站点标识（SiteId，ADR-036）" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="当前站点标识（随数据上行，中心按此区分现场）：" Margin="0,3" />
                    <TextBox Text="{Binding SiteId, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="4" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="保存" Command="{Binding SaveSiteIdCommand}" Padding="14,5" Margin="0,0,8,0" />
                        <Button Content="重新生成" Command="{Binding RegenerateSiteIdCommand}" Padding="14,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding SiteIdStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="首次启动自动生成唯一标识；保存/重新生成后重启生效。格式：小写字母/数字开头、可含连字符、≤32 位（MQTT topic 与 URL 友好）。同一标识被多台机器使用会造成中心数据混淆。" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="MQTT 上报（中心 broker，ADR-025 契约）" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Margin="0,3"><Run Text="Broker：" /><Run Text="{Binding MqttBroker}" /></TextBlock>
                    <TextBlock Margin="0,3"><Run Text="ClientId：" /><Run Text="{Binding MqttClientId}" /></TextBlock>
                    <TextBlock Margin="0,3"><Run Text="连接状态：" /><Run Text="{Binding MqttStateText}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Margin="0,3"><Run Text="转发缓冲积压：" /><Run Text="{Binding BufferBacklogText}" FontWeight="SemiBold" /></TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="中心配置同步（ADR-033 阶段 2：手动导入）" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="中心地址：" Margin="0,3" />
                    <TextBox Text="{Binding CenterUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="4" />
                    <TextBlock Text="中心 Token（JWT）：" Margin="0,3" />
                    <!-- ADR-037 S5：默认 PasswordBox 遮蔽，勾选「显示 Token」切到明文 TextBox（仅内存明文，落盘 DPAPI 加密） -->
                    <Grid>
                        <TextBox x:Name="TokenVisibleBox" Text="{Binding CenterToken, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,3" Padding="4" Visibility="Collapsed" />
                        <PasswordBox x:Name="TokenMaskedBox" PasswordChanged="OnCenterTokenPasswordChanged"
                                     Margin="0,3" Padding="4" />
                    </Grid>
                    <CheckBox x:Name="TokenRevealCheck" Content="显示 Token" IsChecked="False"
                              Checked="OnTokenRevealChecked" Unchecked="OnTokenRevealUnchecked" Margin="0,6,0,0" />
                    <Button Content="从中心导入" Command="{Binding ImportFromCenterCommand}"
                            Margin="0,8,0,4" Padding="14,5" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ImportStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="导入将以中心配置重置本地设备/点位（覆盖前需确认）。地址与 Token 仅保存在本机 %LocalAppData%。"
                               Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="本地存储与采集" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Margin="0,3" TextWrapping="Wrap"><Run Text="SQLite 路径：" /><Run Text="{Binding DatabasePath}" /></TextBlock>
                    <TextBlock Margin="0,3" Text="日志目录：" />
                    <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="4" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="保存日志目录" Command="{Binding SaveLogDirectoryCommand}" Padding="14,5" />
                        <TextBlock Text="{Binding LogDirectoryStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Margin="0,3"><Run Text="采集间隔：" /><Run Text="{Binding CollectionInterval}" /> 毫秒</TextBlock>
                    <TextBlock Margin="0,3"><Run Text="转发间隔：" /><Run Text="{Binding ForwarderInterval}" /> 毫秒</TextBlock>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="说明：桌面端仅本机 UI、本机会话免登录（ADR-026 D5）；远程查看走中心 Webapi/Vue（ADR-025）。"
                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

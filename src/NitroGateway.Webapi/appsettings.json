{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nitrogateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Persistence": {
    "ConnectionString": "Data Source=nitrogateway.db",
    "MeasurementRetentionDays": 30,
    "MeasurementRetentionInterval": "1.00:00:00"
  },
  "MQTT": {
    "Host": "localhost",
    "Port": 1883,
    "KeepAliveSeconds": 60,
    "MaxReconnectAttempts": 10,
    "ReconnectBackoffBaseMs": 1000,
    "ReconnectMaxIntervalMs": 30000,
    "UseTls": false
  },
  "Collection": {
    "IntervalMs": 1000,
    "MaxConcurrency": 5,
    "CircuitBreakerOpenSeconds": 5,
    "CircuitBreakerMaxOpenSeconds": 300
  },
  "Forwarder": {
    "IntervalMs": 5000
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5100",
  "Security": {
    "JwtSecretKey": "NitroGateway-Dev-SecretKey-ChangeMe-32chars!",
    "Issuer": "NitroGateway",
    "Audience": "NitroGateway",
    "ExpireHours": 8,
    "Users": [
      {
        "Username": "admin",
        "Password": "AQAAAAIAAYagAAAAEFTscME8zi9M7Tz8+169cST67c9myJyb46b/vIH2Ln2DUaPnKFrLHI8Ao29iG0oDbA==",
        "Role": "Admin"
      },
      {
        "Username": "operator",
        "Password": "AQAAAAIAAYagAAAAEE6D2KqaodaEi5J3Lhts1Dwy8KJgaAqLA8kREy7aBo2VVJ7jlJe2loE7/i2uJOGn8w==",
        "Role": "Operator"
      },
      {
        "Username": "viewer",
        "Password": "AQAAAAIAAYagAAAAEBzBkqeFT43Hjqe6G0nlgf9abyn2QIdH9pxCFw8o+V9fsU6mnll5wExB0hnXCRZjeQ==",
        "Role": "Viewer"
      }
    ]
  }
}

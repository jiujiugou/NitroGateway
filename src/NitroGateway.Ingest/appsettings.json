{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ingest-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Persistence": {
    "ConnectionString": "Data Source=ingest.db",
    "MeasurementRetentionDays": 30,
    "MeasurementRetentionInterval": "1.00:00:00"
  },
  "MQTT": {
    "Host": "localhost",
    "Port": 1883,
    "KeepAliveSeconds": 60,
    "MaxReconnectAttempts": 10,
    "ReconnectBackoffBaseMs": 1000,
    "ReconnectMaxIntervalMs": 30000,
    "UseTls": false
  },
  "Urls": "http://0.0.0.0:5200"
}

{
  "stryker-config": {
    "project": "NitroGateway.Command.csproj",
    "mutate": ["**/*.cs", "!**/obj/**", "!**/bin/**"],
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": ["json", "progress", "cleartext"],
    "thresholds": { "high": 80, "low": 60, "break": 60 },
    "ignore-methods": ["Log*", "ConfigureAwait", "*Exception.ctor"]
  }
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />
    <PackageReference Include="xunit" Version="*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="*" />
    <!-- 与 Logging 同步对齐 10.0.11（Identity.Core 链要求 DI >= 10.0.11），避免 NU1605 降级 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!-- 版本随 OPC Server 传递依赖对齐（Core 1.5.378.156 要求 Logging >= 10.0.8），与 OpcUa 驱动解析版本一致。
         10.0.11：写功能（docs/14）使 Device → Security（Identity.Core 10.0.11 要求 Logging >= 10.0.11）进入本图，直接引用对齐避免 NU1605 降级。 -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <!-- ADR-019：进程内 OPC UA Server（冒烟替代 Prosys）。版本 1.5.378.145 与客户端 1.5.378.156 同源，
         NuGet 向上统一 Core/Types/Configuration 到 1.5.378.156，Server 程序集加载仍兼容。 -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.378.145" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NitroGateway.Domain\NitroGateway.Domain.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Shared\NitroGateway.Shared.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Collection\NitroGateway.Collection.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Forwarder\NitroGateway.Forwarder.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Protocol\Modbus\NitroGateway.Protocol.Modbus.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Protocol\OpcUa\NitroGateway.Protocol.OpcUa.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Storage\Buffer\NitroGateway.Storage.Buffer.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Storage\TimeSeries\NitroGateway.Storage.TimeSeries.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Transport\HTTP\NitroGateway.Transport.HTTP.csproj" />
    <ProjectReference Include="..\..\src\NitroGateway.Transport\MQTT\NitroGateway.Transport.MQTT.csproj" />
  </ItemGroup>

</Project>
